{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Criterion": {
      "additionalProperties": false,
      "description": "One score criterion: a 1-5 rating against written anchors, weighted by code.",
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "question": {
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "weight": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Weight",
          "type": "number"
        },
        "fields": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Fields",
          "type": "array"
        },
        "anchors": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Anchors",
          "type": "object"
        }
      },
      "required": [
        "id",
        "name",
        "question",
        "weight",
        "fields",
        "anchors"
      ],
      "title": "Criterion",
      "type": "object"
    },
    "Exclusions": {
      "additionalProperties": false,
      "properties": {
        "domains": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Domains",
          "type": "array"
        },
        "categories": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Categories",
          "type": "array"
        }
      },
      "title": "Exclusions",
      "type": "object"
    },
    "SizeRange": {
      "additionalProperties": false,
      "properties": {
        "metric": {
          "enum": [
            "annual_revenue_usd",
            "employees"
          ],
          "title": "Metric",
          "type": "string"
        },
        "min": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min"
        },
        "max": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max"
        }
      },
      "required": [
        "metric"
      ],
      "title": "SizeRange",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One segment and its ideal-customer rules. Undecided fields are null with a reason.\n\nThe score routes a lead: at or above `score_threshold` to research; from `near_miss_min`\nup to the threshold to a person as a near miss; below `near_miss_min` out.",
  "properties": {
    "schema_version": {
      "const": "2",
      "title": "Schema Version",
      "type": "string"
    },
    "segment_id": {
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "title": "Segment Id",
      "type": "string"
    },
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "scope": {
      "minLength": 1,
      "title": "Scope",
      "type": "string"
    },
    "regions": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Regions",
      "type": "array"
    },
    "categories": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Categories",
      "type": "array"
    },
    "size_range": {
      "anyOf": [
        {
          "$ref": "#/$defs/SizeRange"
        },
        {
          "type": "null"
        }
      ]
    },
    "exclusions": {
      "$ref": "#/$defs/Exclusions"
    },
    "score_threshold": {
      "anyOf": [
        {
          "maximum": 100,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Score Threshold"
    },
    "near_miss_min": {
      "anyOf": [
        {
          "maximum": 100,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Near Miss Min"
    },
    "criteria": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/Criterion"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "title": "Criteria"
    },
    "null_reasons": {
      "additionalProperties": {
        "type": "string"
      },
      "default": {},
      "title": "Null Reasons",
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "segment_id",
    "name",
    "scope",
    "regions",
    "categories",
    "size_range",
    "exclusions",
    "score_threshold",
    "near_miss_min",
    "criteria"
  ],
  "title": "SegmentConfig",
  "type": "object"
}
