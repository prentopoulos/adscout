    "mapping": {
      "lead_outcome": "#/$defs/OutcomeRecord",
      "run": "#/$defs/RunRecord",
      "step": "#/$defs/StepRecord"
    },
    "propertyName": "record"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/RunRecord"
    },
    {
      "$ref": "#/$defs/StepRecord"
    },
    {
      "$ref": "#/$defs/OutcomeRecord"
    }
  ],
  "title": "ExportLine"
}
