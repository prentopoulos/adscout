        },
        "adscout.step.name": {
          "title": "Adscout.Step.Name",
          "type": "string"
        },
        "adscout.seed_row": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Adscout.Seed Row"
